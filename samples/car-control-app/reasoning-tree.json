      ]
    },
    {
      "id": "D-LIFECYCLE",
      "type": "decision",
      "title": "采用混合型生命周期",
      "status": "recommended",
      "confidence": "medium",
      "rationale": "关键安全、合规、接口与验收工作采用预测型治理；移动端体验和可拆分功能采用迭代开发；通过固定集成列车与阶段门衔接。",
      "sourceIds": [
        "J-GOVERNANCE",
        "J-ITERATION",
        "J-INTEGRATION"
      ],
      "alternatives": [
        {
          "id": "ALT-PREDICTIVE",
          "title": "纯预测型",
          "rejectedBecause": "难以及时吸收车主对移动端体验的反馈。"
        },
        {
          "id": "ALT-ADAPTIVE",
          "title": "纯适应型",
          "rejectedBecause": "不足以支撑安全边界、关键接口、合规证据与发布审批的前置治理。"
        }
      ]
    },
