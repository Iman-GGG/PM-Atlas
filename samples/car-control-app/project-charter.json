    "high_level_requirements": {
      "value": [
        "支持账号实名认证、车辆绑定与解绑",
        "支持车辆状态、充电状态和车辆位置查询",
        "支持经过授权的车门与空调远程控制",
        "支持预约充电、消息通知、操作反馈和完整审计",
