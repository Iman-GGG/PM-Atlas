    "project_purpose": {
      "value": "建设面向个人车主的统一手机端车辆服务入口，通过 iOS、Android、云端服务与车端接口协同，提供可信的车况查询、充电管理和受控远程操作能力。项目采用混合型生命周期：安全、隐私、关键接口和发布门槛前置治理，移动端体验与可拆分功能迭代验证。",
      "status": "inferred",
      "sourceIds": [
        "INT-002",
        "INT-003",
        "D-LIFECYCLE"
      ]
    },
    "business_need": {
      "value": "当前车主数字服务入口分散、状态反馈不一致，不同车型之间的服务体验存在差异。业务需要在不降低车辆控制安全和数据合规水平的前提下，建立统一、可扩展、可观测的移动服务能力。",
      "status": "inferred",
      "sourceIds": [
        "INT-002",
        "INT-004"
      ]
    },
    "expected_value": {
      "value": [
        "为车主提供统一、可信、易用的车辆数字服务入口",
        "提升远程服务成功率和车主满意度",
        "形成可复用于多车型的移动端、云端和车端集成能力",
        "通过审计、监控和安全控制降低远程车辆操作风险"
      ],
      "status": "assumed",
